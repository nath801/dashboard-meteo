# Copier ce fichier en .env (exclu de Git) puis adapter.
# Open-Meteo ne demande pas de clé d'API.
CACHE_TTL_MINUTES=30
REQUEST_TIMEOUT=8

# Authentification
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=5
# true = onglet « Créer un compte » (protégé par captcha + limite de comptes par IP et par heure)
ALLOW_SIGNUP=false
SIGNUP_MAX_PER_HOUR=3
IP_MAX_FAILURES=20
IP_WINDOW_MINUTES=15
# Captcha demandé à la connexion après ce nombre d'échecs ; durée de validité d'un captcha (s)
CAPTCHA_AFTER_FAILURES=3
CAPTCHA_TTL_SECONDS=300
